# --- Supabase (single project, multi-tenant via RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (ingestion AI) ---
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Meta Marketing API ---
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=

# --- Webhook ingest ---
# Comma-separated list of allowed source slugs (zapier, calendly, native, ...).
WEBHOOK_ALLOWED_SOURCES=zapier,calendly,native,meta
# Optional shared secret required as `x-ingest-secret` header on inbound webhooks.
INGEST_SHARED_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
