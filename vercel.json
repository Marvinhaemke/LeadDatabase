{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter dashboard build",
  "outputDirectory": "apps/dashboard/.next",
  "crons": [
    {
      "path": "/api/cron/process-webhooks",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sweep-bookings",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync-meta",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/backfill-promoted-fields",
      "schedule": "31 3 * * *"
    }
  ]
}
